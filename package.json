{
  "name": "pull-list-sorter",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare:ocr": "node scripts/prepare-ocr-assets.mjs",
    "dev": "npm run prepare:ocr && vite",
    "build": "npm run prepare:ocr && tsc --noEmit && vite build",
    "preview": "vite preview --host 0.0.0.0",
    "test": "node --import tsx --test src/*.test.ts",
    "check": "npm test && npm run build"
  },
  "dependencies": {
    "@tesseract.js-data/eng": "1.0.0",
    "pdfjs-dist": "6.4.299",
    "tesseract.js": "7.0.0"
  },
  "devDependencies": {
    "@types/node": "26.6.6",
    "tsx": "4.23.15",
    "typescript": "7.0.2",
    "vite": "8.3.5"
  }
}
